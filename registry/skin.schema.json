{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/schemas/skin-market-entry.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "author", "description", "repo", "package", "rowId", "tags", "modes", "install", "compatibility", "screenshots", "license", "featuredRank", "starsSnapshot", "releaseUpdatedAt", "metadataUpdatedAt", "starsUpdatedAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": { "zh": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$" },
    "subpath": { "type": "string", "minLength": 1 },
    "package": { "type": "string", "minLength": 1 },
    "rowId": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["light", "dark"] } },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "version", "commit"],
      "properties": {
        "target": { "type": "string", "pattern": "^github:[^#]+#[0-9a-f]{40}(?:&path:[A-Za-z0-9._/-]+)?$" },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "allowBuild": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dsh", "platform"],
      "properties": {
        "dsh": { "type": "string", "minLength": 1 },
        "platform": { "type": "array", "contains": { "const": "web" }, "items": { "type": "string" } }
      }
    },
    "screenshots": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "preview", "installation"],
      "properties": {
        "compatibility": { "enum": ["verified", "unverified"] },
        "preview": { "enum": ["verified", "repository-card"] },
        "installation": { "enum": ["verified", "manual-only"] }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "commercialUse"],
      "properties": { "code": { "type": "string", "minLength": 1 }, "commercialUse": { "type": "boolean" }, "notice": { "type": "string" } }
    },
    "featuredRank": { "type": "integer", "minimum": 0 },
    "starsSnapshot": { "type": "integer", "minimum": 0 },
    "releaseUpdatedAt": { "type": "string", "format": "date-time" },
    "metadataUpdatedAt": { "type": "string", "format": "date-time" },
    "starsUpdatedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
